# Public build settings for the production site (read by `vite build`).
# Nothing secret belongs here: everything VITE_* ends up in the browser.

# The worker (forecasts, accounts, map tiles). Public address, not a secret;
# set here so every build — site and apps — talks to the real worker.
VITE_MAP_PROXY_URL=https://fjallkoll-worker.fabian-n-sund.workers.dev

# Where shared links point from inside the apps (whose own address is localhost).
VITE_PUBLIC_SITE_URL=https://fjallkoll.pages.dev

# Cloudflare Turnstile site key (public). While empty, signup shows no robot
# check; set it together with the worker secret TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFP30ifEeD290W8o
